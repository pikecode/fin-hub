POSTGRES_DB=finhub
POSTGRES_USER=finhub
POSTGRES_PASSWORD=replace-with-strong-database-password

APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://admin.example.com
TARO_APP_API_BASE_URL=https://api.example.com

# Prebuilt image deployment. Use a git SHA or release version instead of latest
# for production rollbacks.
IMAGE_TAG=latest
API_IMAGE=fin-hub-api:latest
ADMIN_WEB_IMAGE=fin-hub-admin-web:latest

DINGTALK_SYNC_MODE=real
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_DRIVE_UNION_ID=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_OAPI_BASE_URL=https://oapi.dingtalk.com
